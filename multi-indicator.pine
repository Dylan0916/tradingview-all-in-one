//@version=5
indicator("All-in-One (EMA + WMA + MACD)", overlay=false, max_lines_count=500, max_labels_count=500)

// ==================== EMA Settings ====================
emaGroup = "EMA Settings"
showEma1 = input.bool(true, "Show EMA 1", group=emaGroup)
ema1Length = input.int(20, "EMA 1 Length", minval=1, group=emaGroup)

showEma2 = input.bool(true, "Show EMA 2", group=emaGroup)
ema2Length = input.int(50, "EMA 2 Length", minval=1, group=emaGroup)

showEma3 = input.bool(true, "Show EMA 3", group=emaGroup)
ema3Length = input.int(100, "EMA 3 Length", minval=1, group=emaGroup)

showEma4 = input.bool(true, "Show EMA 4", group=emaGroup)
ema4Length = input.int(200, "EMA 4 Length", minval=1, group=emaGroup)

// ==================== WMA Settings ====================
wmaGroup = "WMA Settings"
showWma = input.bool(true, "Show WMA", group=wmaGroup)
wmaLength = input.int(300, "WMA Length", minval=1, group=wmaGroup)

// ==================== MACD Settings ====================
macdGroup = "MACD Settings"
showMacd = input.bool(true, "Show MACD", group=macdGroup)
macdFastLength = input.int(12, "Fast Length", minval=1, group=macdGroup)
macdSlowLength = input.int(26, "Slow Length", minval=1, group=macdGroup)
macdSignalLength = input.int(9, "Signal Length", minval=1, group=macdGroup)
macdSource = input.source(close, "MACD Source", group=macdGroup)

// ==================== Divergence Settings ====================
divGroup = "Divergence Settings"
isDivergenceShown = input.bool(true, "Show Divergence", group=divGroup)
pivotLookbackLeft = input.int(5, "Pivot Lookback Left", minval=1, group=divGroup)
pivotLookbackRight = input.int(5, "Pivot Lookback Right", minval=1, group=divGroup)
maxDivergenceRange = input.int(60, "Max Lookback Range", minval=10, maxval=200, group=divGroup)
bullDivColor = input.color(#26A69A, "Bullish Divergence Color", group=divGroup)
bearDivColor = input.color(#EF5350, "Bearish Divergence Color", group=divGroup)

// ==================== EMA Calculations & Plots (Main Chart) ====================
ema1 = ta.ema(close, ema1Length)
ema2 = ta.ema(close, ema2Length)
ema3 = ta.ema(close, ema3Length)
ema4 = ta.ema(close, ema4Length)

// Color and width are configured in "Style" tab, not "Inputs"
plot(showEma1 ? ema1 : na, "EMA 1", #00bcd4, 1, force_overlay=true)
plot(showEma2 ? ema2 : na, "EMA 2", #ff9800, 1, force_overlay=true)
plot(showEma3 ? ema3 : na, "EMA 3", #ab47bc, 1, force_overlay=true)
plot(showEma4 ? ema4 : na, "EMA 4", #ef5350, 4, force_overlay=true)

// ==================== WMA Calculations & Plots (Main Chart) ====================
wma = ta.wma(close, wmaLength)
plot(showWma ? wma : na, "WMA 300", #4caf50, 2, force_overlay=true)

// ==================== MACD Calculations ====================
[macdLine, signalLine, histLine] = ta.macd(macdSource, macdFastLength, macdSlowLength, macdSignalLength)

// Histogram color (green when rising, red when falling)
histColor = histLine >= histLine[1] ? #26A69A : #EF5350

// Plot MACD (using original values without normalization)
plot(showMacd ? histLine : na, "MACD Histogram", histColor, style=plot.style_columns)
plot(showMacd ? macdLine : na, "MACD Line", #2962FF, 1)
plot(showMacd ? signalLine : na, "MACD Signal", #FF6D00, 1)

// ==================== Reference Lines ====================
hline(0, "MACD Zero Line", color.gray, hline.style_dashed)

// ==================== MACD Divergence Detection ====================
// Detect pivot lows on MACD line (for bullish divergence)
macdPivotLow = ta.pivotlow(macdLine, pivotLookbackLeft, pivotLookbackRight)
// Detect pivot highs on MACD line (for bearish divergence)
macdPivotHigh = ta.pivothigh(macdLine, pivotLookbackLeft, pivotLookbackRight)

// Pivot found conditions
bool plFound = not na(macdPivotLow)
bool phFound = not na(macdPivotHigh)

// ---- Bullish Divergence: Price makes lower low, MACD makes higher low ----
// Use ta.valuewhen to get the current (occurrence=0) and previous (occurrence=1) pivot values
// Use ta.lowest to find the actual lowest price in the pivot area (not just a single bar)
float pivotAreaLow = ta.lowest(low, pivotLookbackLeft + pivotLookbackRight + 1)

float currMacdLow = ta.valuewhen(plFound, macdLine[pivotLookbackRight], 0)
int currMacdLowBar = ta.valuewhen(plFound, bar_index[pivotLookbackRight], 0)
float currPriceLow = ta.valuewhen(plFound, pivotAreaLow, 0)

float prevMacdLow = ta.valuewhen(plFound, macdLine[pivotLookbackRight], 1)
int prevMacdLowBar = ta.valuewhen(plFound, bar_index[pivotLookbackRight], 1)
float prevPriceLow = ta.valuewhen(plFound, pivotAreaLow, 1)

// Check bullish divergence: price lower low + MACD higher low
bool isBullishDiv = plFound and currPriceLow < prevPriceLow and currMacdLow > prevMacdLow and (currMacdLowBar - prevMacdLowBar) <= maxDivergenceRange

if isDivergenceShown and showMacd and isBullishDiv
    // Draw line on MACD panel connecting the two MACD lows
    line.new(prevMacdLowBar, prevMacdLow, currMacdLowBar, currMacdLow, color=bullDivColor, width=2)
    label.new(currMacdLowBar, currMacdLow, "Bull", style=label.style_label_up, color=bullDivColor, textcolor=color.white, size=size.tiny)

// ---- Bearish Divergence: Price makes higher high, MACD makes lower high ----
// Use ta.highest to find the actual highest price in the pivot area
float pivotAreaHigh = ta.highest(high, pivotLookbackLeft + pivotLookbackRight + 1)

float currMacdHigh = ta.valuewhen(phFound, macdLine[pivotLookbackRight], 0)
int currMacdHighBar = ta.valuewhen(phFound, bar_index[pivotLookbackRight], 0)
float currPriceHigh = ta.valuewhen(phFound, pivotAreaHigh, 0)

float prevMacdHigh = ta.valuewhen(phFound, macdLine[pivotLookbackRight], 1)
int prevMacdHighBar = ta.valuewhen(phFound, bar_index[pivotLookbackRight], 1)
float prevPriceHigh = ta.valuewhen(phFound, pivotAreaHigh, 1)

// Check bearish divergence: price higher high + MACD lower high
bool isBearishDiv = phFound and currPriceHigh > prevPriceHigh and currMacdHigh < prevMacdHigh and (currMacdHighBar - prevMacdHighBar) <= maxDivergenceRange

if isDivergenceShown and showMacd and isBearishDiv
    // Draw line on MACD panel connecting the two MACD highs
    line.new(prevMacdHighBar, prevMacdHigh, currMacdHighBar, currMacdHigh, color=bearDivColor, width=2)
    label.new(currMacdHighBar, currMacdHigh, "Bear", style=label.style_label_down, color=bearDivColor, textcolor=color.white, size=size.tiny)
